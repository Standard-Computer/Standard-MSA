# Standard-MSA configuration — placeholders only. NEVER commit real values.
# Copy to .env and fill in locally; secrets stay out of the repo and out of the DB.

# SQLite database file (created on first migrate).
DATABASE_URL="file:./data/standard-msa.db"

# Public base URL of this instance (used in MSA links and the /legal embed).
APP_BASE_URL="http://localhost:3000"

# Shared secret for the scheduled-job endpoints (/api/cron/*). Generate a
# long random value; send it as "Authorization: Bearer <value>".
CRON_SECRET=""

# Optional salt for the "hash visitor IPs" option on the /legal visitor log.
# Any long random string; changing it orphans previously hashed values.
VISIT_IP_HASH_SALT=""

# Email delivery — configure ONE provider. Keys come from the environment,
# never from the repo or the database.
# SMTP2GO:
SMTP2GO_API_KEY=""
# SendGrid:
SENDGRID_API_KEY=""
# Plain SMTP:
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
