# Standard-MSA configuration — placeholders only. NEVER commit real values.
# Copy to .env and fill in locally; secrets stay out of the repo and out of the DB.

# SQLite database file (created on first migrate).
DATABASE_URL="file:./data/standard-msa.db"

# Public base URL of this instance (used in MSA links and the /legal embed).
APP_BASE_URL="http://localhost:3000"

# Email delivery — configure ONE provider. Keys come from the environment,
# never from the repo or the database.
# SMTP2GO:
SMTP2GO_API_KEY=""
# SendGrid:
SENDGRID_API_KEY=""
# Plain SMTP:
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
