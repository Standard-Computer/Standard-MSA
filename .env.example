# Standard-MSA configuration — placeholders only. NEVER commit real values.
# Copy to .env and fill in locally; secrets stay out of the repo and out of the DB.

# SQLite database file (created on first migrate).
DATABASE_URL="file:./data/standard-msa.db"

# Public base URL of this instance (used in MSA links, the /legal embed, and
# email open/click tracking URLs).
APP_BASE_URL="http://localhost:3000"

# Operator sign-in. One shared password for the single-operator v0 model; use
# a long random value of at least 12 characters. Changing it signs out every
# open session, which is also how you revoke one.
#
# Leaving this unset is supported: the instance is then UNCLAIMED, and the
# first visit to any operator screen offers a one-time /setup page that sets
# the password and stores it hashed (SHA-4455). That is how the one-click
# Railway deploy works — no default credentials ship anywhere. Whoever opens
# the instance first sets the password, so on a public URL, do it immediately.
#
# A value set here ALWAYS wins over one set at /setup, and is how you recover
# an instance whose stored password was lost. A value that is present but
# shorter than 12 characters fails closed: the operator screens stay shut and
# /setup does NOT reopen, because that instance has an owner.
OPERATOR_PASSWORD=""

# Optional salt for the "hash visitor IPs" option on the /legal visitor log.
# Any long random string; changing it orphans previously hashed values.
VISIT_IP_HASH_SALT=""

# Email delivery — pick ONE provider (smtp2go | sendgrid | smtp) and set its
# key. Keys come from the environment, never from the repo or the database.
# Provider and from-address can also be set in Settings → Email; env wins.
EMAIL_PROVIDER=""
EMAIL_FROM=""
# SMTP2GO:
SMTP2GO_API_KEY=""
# SendGrid:
SENDGRID_API_KEY=""
# Plain SMTP:
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_SECURE="false"

# Webhook ingestion (/api/email/webhooks/<provider>): shared secret the
# provider includes as ?key=... in the webhook URL. Without this (or the
# SendGrid signed-webhook key below) webhook requests are rejected.
# Use a long random value (16+ chars): values shorter than 6 chars are not
# redacted from error messages/logs (redacting tiny strings shreds text).
EMAIL_WEBHOOK_SECRET=""
# SendGrid signed event webhook verification key (base64, from their UI).
SENDGRID_WEBHOOK_PUBLIC_KEY=""

# Shared secret for the scheduled-job endpoints (/api/cron/*: queue sweep,
# liveness checks, webhook deliveries). Callers send it as
# "Authorization: Bearer <value>". Use a long random value (16+ chars); the
# same shorter-than-6-chars redaction caveat applies.
CRON_SECRET=""

# Public API (/api/v1) rate limit, requests per minute per API key.
# Keys themselves are created in Settings -> API, never configured here.
API_RATE_LIMIT_PER_MINUTE="120"
