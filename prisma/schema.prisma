// Standard-MSA data model (v0 scaffold).
//
// SQLite by default: the tool keeps a LOCAL database (Sean's requirement) and
// must self-host with zero external services. Postgres can be offered later
// behind the same Prisma schema if an MSP wants it; keep fields portable
// (no sqlite-only tricks).
//
// Children extend this via `prisma migrate` in their own lanes:
//   SHA-2956 onboarding   -> MspIdentity
//   SHA-2957 /legal embed -> LegalDocument/Version, LegalVisit, SiteCheck
//   SHA-2958 email        -> EmailProviderConfig (names of env vars, never values)
//   SHA-2959 sends        -> Recipient, Send, SendEvent, AcceptanceRecord, UpdateNotice
//   SHA-2960 API          -> ApiKey
// Schema changes are add-only (company standing bar).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── MSP identity / brand (onboarding, SHA-2956) ─────────────────────────────

model MspIdentity {
  id         Int      @id @default(autoincrement())
  name       String // trading name, e.g. "Standard Computer"
  legalName  String? // legal entity name used in the contract header
  address    String?
  ownerName  String? // owner / CEO, used as signatory
  email      String? // MSP notification address (liveness alerts etc.)
  website    String?
  venue      String? // governing law / venue line, composed from the parts below
  logoUrl    String?
  // SHA-2956: venue is collected as state/province + country and composed
  // into `venue` on save. The parts are kept so re-running the wizard edits
  // what the MSP actually typed, not a string we would have to parse apart.
  venueState   String?
  venueCountry String?
  // SHA-2956 onboarding state. The wizard is skippable and re-runnable; a
  // row with neither timestamp (or no row at all) sends the first visit to
  // /onboarding. Completing clears skippedAt.
  onboardingCompletedAt DateTime?
  onboardingSkippedAt   DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ── Legal documents and versions (SHA-2957) ─────────────────────────────────

model LegalDocument {
  id        Int                    @id @default(autoincrement())
  slug      String                 @unique // e.g. "msa", "hipaa-baa"
  title     String
  kind      String                 @default("msa")
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  versions  LegalDocumentVersion[]
}

model LegalDocumentVersion {
  id            Int           @id @default(autoincrement())
  documentId    Int
  document      LegalDocument @relation(fields: [documentId], references: [id])
  version       Int
  bodyMarkdown  String // contract body with {{variable}} placeholders
  variablesJson String        @default("{}") // defaults for merge variables
  changelog     String?
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  sends         Send[]

  @@unique([documentId, version])
}

// Every visit to the public /legal pages (timestamp, IP, region — Sean's ask).
// SHA-2957 widened this add-only: the embed frame's beacon carries a random,
// cookie-free visitId so the read-timer can accrue seconds onto the same row,
// and country/region come from proxy geo headers (never a paid lookup). What
// is stored and for how long is documented in README § Visitor log; retention
// and IP hashing are operator knobs on LegalSettings.
model LegalVisit {
  id            Int      @id @default(autoincrement())
  path          String
  slug          String?
  version       Int?
  occurredAt    DateTime @default(now())
  ip            String? // null when hashVisitorIps is on
  ipHash        String? // salted SHA-256, only when hashVisitorIps is on
  userAgent     String?
  referer       String?
  region        String? // derived from IP when resolvable; never a paid lookup
  country       String?
  visitId       String?  @unique // random per frame load; keys read-timer pings
  theme         String?
  embedded      Boolean  @default(false) // frame beacon vs direct /legal page
  secondsOnPage Int      @default(0) // accrued by the read-timer, server-clamped
  docsJson      String   @default("[]") // slugs rendered in an all-docs frame view

  @@index([occurredAt])
  @@index([slug, occurredAt])
}

// Liveness checks of the MSP-site embed (is /legal live on their site?).
model SiteCheck {
  id         Int      @id @default(autoincrement())
  targetUrl  String
  ok         Boolean
  statusCode Int?
  detail     String?
  checkedAt  DateTime @default(now())
  alerted    Boolean  @default(false)
}

// Singleton settings for the public /legal surface and embed (SHA-2957).
// embedOriginsJson is a JSON string[] of normalized origins; empty = any
// (frame-ancestors is a passing-off control here, not confidentiality — the
// content is public by definition; see src/lib/legal/embed.ts).
model LegalSettings {
  id                 Int      @id @default(autoincrement())
  embedEnabled       Boolean  @default(true)
  embedOriginsJson   String   @default("[]")
  introText          String?
  footerText         String?
  accentColor        String   @default("#1d4ed8")
  visitRetentionDays Int      @default(365)
  hashVisitorIps     Boolean  @default(false)
  monitorEnabled     Boolean  @default(false)
  monitorUrl         String? // the MSP's own public /legal page to probe
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// Debounce state for the liveness monitor (SHA-2957): one alert per outage
// on the up->down transition (after 2 consecutive failures), one recovery
// notice on down->up, nothing in between. Singleton row.
model MonitorState {
  id                  Int       @id @default(autoincrement())
  status              String    @default("unknown") // unknown|up|down
  consecutiveFailures Int       @default(0)
  downSince           DateTime?
  lastAlertAt         DateTime?
  lastRecoveryAt      DateTime?
  lastCheckedAt       DateTime?
  lastDetail          String?
  updatedAt           DateTime  @updatedAt
}

// ── Recipients and sends (SHA-2959) ─────────────────────────────────────────

model Recipient {
  id          Int      @id @default(autoincrement())
  email       String
  fullName    String?
  companyName String?
  legalName   String?
  address     String?
  phone       String?
  createdAt   DateTime @default(now())
  sends       Send[]
}

// One outbound MSA to one recipient: its own unique token/URL, recipient
// details merged into the document, whole lifecycle tracked in SendEvent.
model Send {
  id                Int                  @id @default(autoincrement())
  token             String               @unique // unguessable URL token
  documentVersionId Int
  documentVersion   LegalDocumentVersion @relation(fields: [documentVersionId], references: [id])
  recipientId       Int
  recipient         Recipient            @relation(fields: [recipientId], references: [id])
  mergedVarsJson    String               @default("{}") // variables as merged at send time
  status            String               @default("created") // created|sent|delivered|opened|accepted|declined|bounced
  createdAt         DateTime             @default(now())
  sentAt            DateTime?
  acceptedAt        DateTime?
  events            SendEvent[]
  acceptance        AcceptanceRecord?
}

// Append-only lifecycle log, kept as acceptance evidence.
model SendEvent {
  id         Int      @id @default(autoincrement())
  sendId     Int
  send       Send     @relation(fields: [sendId], references: [id])
  type       String // created|sent|delivered|opened|clicked|viewed|accepted|declined|bounced
  occurredAt DateTime @default(now())
  ip         String?
  userAgent  String?
  metaJson   String   @default("{}") // clicked URL, read-time ms, provider signal id…

  @@index([sendId, occurredAt])
}

model AcceptanceRecord {
  id            Int      @id @default(autoincrement())
  sendId        Int      @unique
  send          Send     @relation(fields: [sendId], references: [id])
  acceptedAt    DateTime
  acceptorName  String?
  ip            String?
  userAgent     String?
  signatureJson String   @default("{}") // typed/drawn signature payload
  evidenceJson  String   @default("{}") // frozen event-trail snapshot at acceptance
}

// ── Update notifications (SHA-2959) ─────────────────────────────────────────

model UpdateNotice {
  id                   Int      @id @default(autoincrement())
  documentVersionId    Int // the NEW version recipients are notified about
  audience             String // all|accepted|selected
  recipientIdsJson     String   @default("[]")
  createdAt            DateTime @default(now())
  sentAt               DateTime?
}

// ── Email provider config (SHA-2958) ────────────────────────────────────────
// Stores provider choice and non-secret settings ONLY. Secret values live in
// the environment; this row records which env var NAME to read, never a value.

model EmailProviderConfig {
  id            Int      @id @default(autoincrement())
  provider      String // smtp2go|sendgrid|smtp
  fromAddress   String
  settingsJson  String   @default("{}") // host/port/username, env var names for secrets
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// One queued/attempted outbound message. The id doubles as the per-send
// unique identifier C5 needs: stamped as X-StandardMSA-Outbound-Id, used in
// the open-pixel and click routes, echoed back by provider webhooks.
model EmailOutbound {
  id                String               @id @default(uuid())
  toAddress         String
  subject           String
  bodyText          String
  bodyHtml          String?
  kind              String               @default("transactional") // caller tag: send|notice|test|…
  refJson           String               @default("{}") // caller reference, e.g. {"sendId":12}
  provider          String? // adapter slug resolved at send time
  status            String               @default("queued") // queued|sending|sent|failed|bounced|complained
  attempts          Int                  @default(0)
  nextAttemptAt     DateTime             @default(now())
  lastError         String? // always redacted before storage
  providerMessageId String?
  linksJson         String               @default("[]") // click-wrapped targets by index (no open redirect)
  openedAt          DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  events            EmailDeliveryEvent[]

  @@index([status, nextAttemptAt])
  @@index([providerMessageId])
}

// Append-only delivery log other modules read (bounces, complaints, opens,
// clicks — from our pixel/click routes and from provider webhooks).
model EmailDeliveryEvent {
  id         Int           @id @default(autoincrement())
  outboundId String
  outbound   EmailOutbound @relation(fields: [outboundId], references: [id])
  type       String // queued|sent|delivered|bounced|complained|opened|clicked|failed
  source     String        @default("app") // app|webhook|pixel|click
  occurredAt DateTime      @default(now())
  metaJson   String        @default("{}")

  @@index([outboundId, occurredAt])
}

// ── API surface (SHA-2960) ──────────────────────────────────────────────────

model ApiKey {
  id         Int       @id @default(autoincrement())
  name       String
  keyHash    String    @unique // sha256 of the key; plaintext shown once at creation
  prefix     String    @default("") // display prefix ("smsa_ab12cd34…") for the keys screen
  scopesJson String    @default("[]") // JSON string[] of scopes; [] = all scopes
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
  requests   ApiRequestLog[]
}

// Per-key request log (SHA-2960): one row per authenticated API request, so
// an MSP can see what each integration actually did with its key.
model ApiRequestLog {
  id         Int      @id @default(autoincrement())
  apiKeyId   Int
  apiKey     ApiKey   @relation(fields: [apiKeyId], references: [id])
  method     String
  path       String
  status     Int
  ip         String?
  durationMs Int      @default(0)
  occurredAt DateTime @default(now())

  @@index([apiKeyId, occurredAt])
}

// Stored idempotency replays (SHA-2960): a POST create retried with the same
// Idempotency-Key returns the stored response instead of a second row.
model ApiIdempotencyKey {
  id             Int      @id @default(autoincrement())
  apiKeyId       Int
  key            String
  endpoint       String // method + route template, e.g. "POST /sends"
  requestHash    String // sha256 of the request body; a mismatch is a 409
  responseStatus Int
  responseBody   String
  createdAt      DateTime @default(now())

  @@unique([apiKeyId, endpoint, key])
  @@index([createdAt])
}

// Outbound webhook subscriptions (SHA-2960). The signing secret is generated
// here and stored as written: HMAC signing needs the plaintext at every
// delivery, and this database is the MSP's own local file — the secret
// protects the MSP's RECEIVING endpoint, not this app.
model Webhook {
  id         Int               @id @default(autoincrement())
  url        String
  eventsJson String            @default("[]") // JSON string[] of event types; [] = all
  secret     String // HMAC-SHA256 signing secret, returned once by the API
  active     Boolean           @default(true)
  createdAt  DateTime          @default(now())
  revokedAt  DateTime?
  deliveries WebhookDelivery[]
}

// One webhook event queued for one subscription, with its retry state and
// the outcome of the last attempt — the auditable "did the PSA hear about
// this acceptance?" record.
model WebhookDelivery {
  id             Int       @id @default(autoincrement())
  webhookId      Int
  webhook        Webhook   @relation(fields: [webhookId], references: [id])
  eventType      String // e.g. "send.accepted"
  payloadJson    String
  status         String    @default("pending") // pending|delivered|exhausted
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  lastStatusCode Int?
  lastError      String?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([status, nextAttemptAt])
  @@index([webhookId, createdAt])
}
